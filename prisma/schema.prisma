generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       Int    @id @default(autoincrement())
  email    String @unique
  name     String
  password String

  @@map("User")
}

model LogEntry {
  id                Int      @id @default(autoincrement())
  department        String
  personWithProblem String
  problem           String
  solution          String
  solvedBy          String
  status            String
  date              DateTime @default(now())

  @@map("log_entries")
}
