generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       Int    @id @default(autoincrement())
  name     String
  email    String @unique
  password String
  role     Role


   
  tokens   RefreshToken[]
     
  @@map("User")
}

enum Role {
  ADMIN
  IT_INTERN
}

model LogEntry {
  id                Int      @id @default(autoincrement())
  department        String
  personWithProblem String
  problem           String
  solution          String
  solvedBy          String
  status            String
  date              DateTime @default(now())

  @@map("log_entries")
}


model RefreshToken {
  id          Int       @id @default(autoincrement())
  token       String    @unique
  userId      Int
  user        User      @relation(fields: [userId], references: [id])
  expiresAt   DateTime


  @@map("tokens")
}
